# ===== Claude =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (medium = توازن جيد بين الجودة والسرعة للمحادثة)
CLAUDE_EFFORT=medium

# ===== WhatsApp Cloud API (Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ===== الإشعارات =====
# رقم واتساب المدير اللي بتوصله الإشعارات (بالصيغة الدولية بدون +)
OWNER_WHATSAPP_NUMBER=
# (اختياري) رابط webhook يستقبل الإشعارات كـ JSON (Zapier / Make / n8n ...)
NOTIFY_WEBHOOK_URL=

# ===== نظام الـ ERP =====
# mock = بيانات تجريبية من knowledge/fleet.yaml ، eganis = الربط الحقيقي
ERP_BACKEND=mock
EGANIS_BASE_URL=
EGANIS_API_KEY=

# ===== عام =====
DB_PATH=data/bot.db
# كلمة سر صفحة التجربة /test
TEST_PAGE_PASSWORD=change-me
